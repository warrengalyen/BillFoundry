@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>

<DemoBanner />

<div class="app-shell">
    <NavMenu @rendermode="RenderMode.InteractiveServer" />

    <main id="main-content" class="app-main" tabindex="-1">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <h1>Something went wrong</h1>
                <p>An unexpected error occurred while rendering this page. Reload to continue.</p>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">Close</button>
</div>
