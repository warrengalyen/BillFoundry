<header class="app-header">
    <button type="button"
            class="nav-toggle"
            aria-controls="app-sidebar"
            aria-expanded="@_navOpen"
            aria-label="@(_navOpen ? "Close navigation" : "Open navigation")"
            @onclick="ToggleNav">
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>
    <a class="app-brand" href="/" @onclick="CloseNav">BillFoundry</a>
    <span class="app-edition">Community</span>
</header>

@if (_navOpen)
{
    <button type="button"
            class="nav-backdrop"
            aria-label="Close navigation"
            @onclick="CloseNav"></button>
}

<nav id="app-sidebar"
     class="app-sidebar@(_navOpen ? " is-open" : string.Empty)"
     aria-label="Primary"
     @onkeydown="OnNavKeyDown">
    <AuthorizeView>
        <Authorized>
            <ul class="nav-list">
                <li>
                    <NavLink class="nav-link" href="Dashboard" Match="NavLinkMatch.All" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                        Dashboard
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="Clients" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Clients
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="Catalog" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
                        Catalog
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="Estimates" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 13H8"/><path d="M16 17H8"/><path d="M16 13h-2"/></svg>
                        Estimates
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="Invoices" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v.5"/><path d="M12 6v.5"/></svg>
                        Invoices
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="Reports" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                        Reports
                    </NavLink>
                </li>
                <AuthorizeView Policy="@AuthorizationPolicies.Administrator">
                    <Authorized Context="auditAccess">
                        <li>
                            <NavLink class="nav-link" href="Audit" @onclick="CloseNav">
                                <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                                Audit log
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@AuthorizationPolicies.ManageOrganizationSettings">
                    <Authorized Context="organizationAccess">
                        <li>
                            <NavLink class="nav-link" href="Settings/Organization" @onclick="CloseNav">
                                <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                                Organization
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
                <li>
                    <NavLink class="nav-link" href="Account/Manage" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Account
                    </NavLink>
                </li>
            </ul>
            <div class="nav-footer">
                <p class="nav-user">@context.User.Identity?.Name</p>
                <NavLink class="nav-link" href="Account/Logout" @onclick="CloseNav">
                    <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Log out
                </NavLink>
            </div>
        </Authorized>
        <NotAuthorized>
            <ul class="nav-list">
                <li>
                    <NavLink class="nav-link" href="Account/Login" @onclick="CloseNav">
                        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                        Log in
                    </NavLink>
                </li>
            </ul>
        </NotAuthorized>
    </AuthorizeView>
</nav>
