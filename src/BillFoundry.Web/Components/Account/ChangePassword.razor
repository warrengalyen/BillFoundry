@page "/Account/Manage/ChangePassword"
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ICurrentUser CurrentUser

<PageTitle>Change password - BillFoundry</PageTitle>

<section class="page-header">
    <h1>Change password</h1>
</section>

<section class="panel" aria-labelledby="password-heading">
    <h2 id="password-heading" class="visually-hidden">Password form</h2>

    @if (Succeeded)
    {
        <p role="status">Your password has been changed.</p>
        <p><a href="/Account/Manage">Return to account</a></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="form-alert" role="alert">@ErrorMessage</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-errors" />

            <div class="form-field">
                <label for="current-password">Current password</label>
                <InputText id="current-password"
                           type="password"
                           class="form-input"
                           @bind-Value="Input.CurrentPassword"
                           autocomplete="current-password"
                           aria-required="true" />
                <ValidationMessage For="() => Input.CurrentPassword" />
            </div>

            <div class="form-field">
                <label for="new-password">New password</label>
                <InputText id="new-password"
                           type="password"
                           class="form-input"
                           @bind-Value="Input.NewPassword"
                           autocomplete="new-password"
                           aria-required="true" />
                <ValidationMessage For="() => Input.NewPassword" />
            </div>

            <div class="form-field">
                <label for="confirm-password">Confirm new password</label>
                <InputText id="confirm-password"
                           type="password"
                           class="form-input"
                           @bind-Value="Input.ConfirmPassword"
                           autocomplete="new-password"
                           aria-required="true" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>

            <button type="submit" class="button-primary">Update password</button>
        </EditForm>
    }
</section>

@code {
    [SupplyParameterFromForm]
    private ChangePasswordInput Input { get; set; } = null!;

    private string? ErrorMessage { get; set; }

    private bool Succeeded { get; set; }

    protected override void OnInitialized() => Input ??= new();

    public async Task ChangeAsync()
    {
        if (CurrentUser.UserId is not Guid userId)
        {
            ErrorMessage = "You must be signed in to change your password.";
            return;
        }

        ApplicationUser? user = await UserManager.FindByIdAsync(userId.ToString());
        if (user is null)
        {
            ErrorMessage = "Your account could not be loaded.";
            return;
        }

        IdentityResult result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            ErrorMessage = string.Join(" ", result.Errors.Select(error => error.Description));
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Succeeded = true;
    }

    private sealed class ChangePasswordInput
    {
        [Required]
        [DataType(DataType.Password)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required]
        [DataType(DataType.Password)]
        [StringLength(100, MinimumLength = 12)]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "The password and confirmation do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
