@page "/Account/ResetPassword"
@attribute [AllowAnonymous]
@layout AccountLayout
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Reset password - BillFoundry</PageTitle>

<section class="panel account-panel" aria-labelledby="reset-heading">
    <h1 id="reset-heading">Reset password</h1>

    @if (Completed)
    {
        <p role="status">Your password has been reset.</p>
        <p><a href="/Account/Login">Log in</a></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="form-alert" role="alert">@ErrorMessage</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-errors" />

            <input type="hidden" name="Input.Token" value="@Input.Token" />
            <input type="hidden" name="Input.Email" value="@Input.Email" />

            <div class="form-field">
                <label for="email">Email</label>
                <InputText id="email" class="form-input" @bind-Value="Input.Email" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="form-field">
                <label for="password">New password</label>
                <InputText id="password"
                           type="password"
                           class="form-input"
                           @bind-Value="Input.Password"
                           autocomplete="new-password"
                           aria-required="true" />
                <ValidationMessage For="() => Input.Password" />
            </div>

            <div class="form-field">
                <label for="confirm-password">Confirm password</label>
                <InputText id="confirm-password"
                           type="password"
                           class="form-input"
                           @bind-Value="Input.ConfirmPassword"
                           autocomplete="new-password"
                           aria-required="true" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>

            <button type="submit" class="button-primary">Reset password</button>
        </EditForm>
    }
</section>

@code {
    [SupplyParameterFromForm]
    private ResetPasswordInput Input { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private string? ErrorMessage { get; set; }

    private bool Completed { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();

        if (!string.IsNullOrEmpty(Email))
        {
            Input.Email = Email;
        }

        if (!string.IsNullOrEmpty(Token))
        {
            Input.Token = Token;
        }
    }

    public async Task ResetAsync()
    {
        if (string.IsNullOrWhiteSpace(Input.Token))
        {
            ErrorMessage = "The password reset token is missing or invalid.";
            return;
        }

        string token;
        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Token));
        }
        catch (FormatException)
        {
            ErrorMessage = "The password reset token is missing or invalid.";
            return;
        }

        ApplicationUser? user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            Completed = true;
            return;
        }

        IdentityResult result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded)
        {
            Completed = true;
            return;
        }

        ErrorMessage = string.Join(" ", result.Errors.Select(error => error.Description));
    }

    private sealed class ResetPasswordInput
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [DataType(DataType.Password)]
        [StringLength(100, MinimumLength = 12)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public string Token { get; set; } = string.Empty;
    }
}
