@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@layout AccountLayout
@inject UserManager<ApplicationUser> UserManager
@inject IAccountNotificationService Notifications
@inject NavigationManager Navigation

<PageTitle>Forgot password - BillFoundry</PageTitle>

<section class="panel account-panel" aria-labelledby="forgot-heading">
    <h1 id="forgot-heading">Forgot password</h1>
    <p class="lede">
        Enter your email address. If an account exists, a password reset message will be queued.
        Email delivery is not configured yet.
    </p>

    @if (Submitted)
    {
        <p role="status">If an account exists for that email address, a reset message has been queued.</p>
        <p><a href="/Account/Login">Return to log in</a></p>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot-password">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-errors" role="alert" />

            <div class="form-field">
                <label for="email">Email</label>
                <InputText id="email"
                           class="form-input"
                           @bind-Value="Input.Email"
                           autocomplete="username"
                           aria-required="true" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <button type="submit" class="button-primary">Send reset link</button>
        </EditForm>
    }
</section>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordInput Input { get; set; } = null!;

    private bool Submitted { get; set; }

    protected override void OnInitialized() => Input ??= new();

    public async Task SendAsync()
    {
        Submitted = true;

        ApplicationUser? user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null || !await UserManager.IsEmailConfirmedAsync(user) || user.IsDisabled)
        {
            return;
        }

        string token = await UserManager.GeneratePasswordResetTokenAsync(user);
        string encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
        string resetUrl = Navigation.ToAbsoluteUri(
                $"/Account/ResetPassword?email={Uri.EscapeDataString(Input.Email)}&token={encodedToken}")
            .ToString();

        await Notifications.SendPasswordResetLinkAsync(Input.Email, resetUrl);
    }

    private sealed class ForgotPasswordInput
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
