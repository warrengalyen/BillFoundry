@page "/Reports/Payments"
@attribute [Authorize(Policy = AuthorizationPolicies.ManageInvoices)]
@using BillFoundry.Application.Invoices
@using BillFoundry.Application.Reporting
@using BillFoundry.Web.Invoices
@using BillFoundry.Web.Reporting
@inject IReportingService Reporting
@inject IInvoiceService Invoices

<PageTitle>Payments by month - BillFoundry</PageTitle>

<section class="page-header page-header-split">
    <div>
        <h1>Payments by month</h1>
        <p class="lede">Net receipts by calendar month. Reversals reduce the month in which they were recorded.</p>
    </div>
    <p>
        <a class="button-secondary" href="@ReportQuery.PaymentsByMonthCsv(From, To)">Download CSV</a>
    </p>
</section>

<ReportsNav />

@if (_error is not null)
{
    <div class="form-alert" role="alert">@_error</div>
}

<section class="panel panel-wide">
    <form method="get" class="filter-bar filter-bar-reports">
        <div class="form-field">
            <label for="from">From</label>
            <input id="from" name="From" class="form-input" type="date" value="@(From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="form-field">
            <label for="to">To</label>
            <input id="to" name="To" class="form-input" type="date" value="@(To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="form-actions">
            <button type="submit" class="button-primary">Apply</button>
        </div>
    </form>

    @if (_rows is not null)
    {
        <ReportBarChart Items="_chart" />
        <div class="table-wrap">
            <table class="data-table">
                <caption class="visually-hidden">Net payments by month</caption>
                <thead>
                    <tr>
                        <th scope="col">Period</th>
                        <th class="numeric" scope="col">Receipts</th>
                        <th class="numeric" scope="col">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MonthlyPaymentRow row in _rows)
                    {
                        <tr>
                            <td>@row.PeriodLabel</td>
                            <td class="numeric">@row.PaymentCount</td>
                            <td class="numeric">@InvoiceFormatting.FormatAmount(row.Amount, _currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery]
    public DateOnly? From { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? To { get; set; }

    private IReadOnlyList<MonthlyPaymentRow>? _rows;
    private string? _error;
    private string _currency = "USD";
    private IReadOnlyList<ReportBarItem> _chart = [];

    protected override async Task OnParametersSetAsync()
    {
        InvoiceOptionsResult options = await Invoices.GetOptionsAsync();
        if (options.Succeeded && options.Options is not null)
        {
            _currency = options.Options.CurrencyCode;
        }

        ReportingResult<IReadOnlyList<MonthlyPaymentRow>> result =
            await Reporting.GetPaymentsByMonthAsync(ReportQuery.Create(From, To, null, null));
        if (result.IsForbidden)
        {
            _error = "You are not allowed to view this report.";
            return;
        }

        if (!result.Succeeded || result.Value is null)
        {
            _error = "The payments report could not be loaded.";
            return;
        }

        _rows = result.Value;
        decimal scale = Math.Max(1m, _rows.Max(row => row.Amount));
        _chart = _rows.Select(row => new ReportBarItem(
            row.PeriodLabel,
            row.Amount,
            InvoiceFormatting.FormatAmount(row.Amount, _currency),
            scale)).ToList();
    }
}
