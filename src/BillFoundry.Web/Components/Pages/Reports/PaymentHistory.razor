@page "/Reports/PaymentHistory"
@attribute [Authorize(Policy = AuthorizationPolicies.ManageInvoices)]
@using BillFoundry.Application.Invoices
@using BillFoundry.Application.Reporting
@using BillFoundry.Web.Invoices
@using BillFoundry.Web.Reporting
@inject IReportingService Reporting
@inject IInvoiceService Invoices

<PageTitle>Payment history - BillFoundry</PageTitle>

<section class="page-header page-header-split">
    <div>
        <h1>Payment history</h1>
        <p class="lede">Receipts and reversals in the selected payment-date range. Reversal amounts are negative.</p>
    </div>
    <p>
        <a class="button-secondary" href="@ReportQuery.PaymentHistoryCsv(From, To, ClientId)">Download CSV</a>
    </p>
</section>

<ReportsNav />

@if (_error is not null)
{
    <div class="form-alert" role="alert">@_error</div>
}

<section class="panel panel-wide">
    <form method="get" class="filter-bar filter-bar-reports">
        <div class="form-field">
            <label for="from">From</label>
            <input id="from" name="From" class="form-input" type="date" value="@(From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="form-field">
            <label for="to">To</label>
            <input id="to" name="To" class="form-input" type="date" value="@(To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="form-field">
            <label for="client">Client</label>
            <select id="client" name="ClientId" class="form-input">
                <option value="">All clients</option>
                @foreach (InvoiceClientOption client in _clients)
                {
                    <option value="@client.Id" selected="@(ClientId == client.Id)">@client.Name (@client.Code)</option>
                }
            </select>
        </div>
        <div class="form-actions">
            <button type="submit" class="button-primary">Apply</button>
        </div>
    </form>

    @if (_rows is not null)
    {
        <p class="results-count">@_rows.Count payment row@(_rows.Count == 1 ? "" : "s").</p>
        <div class="table-wrap">
            <table class="data-table">
                <caption class="visually-hidden">Payment history</caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Invoice</th>
                        <th scope="col">Client</th>
                        <th class="numeric" scope="col">Amount</th>
                        <th scope="col">Type</th>
                        <th scope="col">Method</th>
                        <th scope="col">Reference</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PaymentHistoryRow row in _rows)
                    {
                        <tr>
                            <td>@row.PaymentDate.ToString("yyyy-MM-dd")</td>
                            <td><a href="@($"/Invoices/{row.InvoiceId}")">@row.InvoiceNumber</a></td>
                            <td>@row.ClientName</td>
                            <td class="numeric">@InvoiceFormatting.FormatAmount(row.Amount, row.CurrencyCode)</td>
                            <td>@(row.IsReversal ? "Reversal" : "Receipt")</td>
                            <td>@row.MethodLabel</td>
                            <td>@(row.Reference ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery]
    public DateOnly? From { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? To { get; set; }

    [SupplyParameterFromQuery]
    public Guid? ClientId { get; set; }

    private IReadOnlyList<PaymentHistoryRow>? _rows;
    private IReadOnlyList<InvoiceClientOption> _clients = [];
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        InvoiceOptionsResult options = await Invoices.GetOptionsAsync();
        if (options.Succeeded && options.Options is not null)
        {
            _clients = options.Options.Clients;
        }

        ReportingResult<IReadOnlyList<PaymentHistoryRow>> result =
            await Reporting.GetPaymentHistoryAsync(ReportQuery.Create(From, To, ClientId, null));
        if (result.IsForbidden)
        {
            _error = "You are not allowed to view this report.";
            return;
        }

        if (!result.Succeeded || result.Value is null)
        {
            _error = "The payment history report could not be loaded.";
            return;
        }

        _rows = result.Value;
    }
}
