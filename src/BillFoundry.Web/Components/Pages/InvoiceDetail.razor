@page "/Invoices/{Id:guid}"
@attribute [Authorize(Policy = AuthorizationPolicies.ManageInvoices)]
@rendermode InteractiveServer
@using BillFoundry.Application.Invoices
@using BillFoundry.Domain.Catalog
@using BillFoundry.Domain.Invoices
@using BillFoundry.Web.Invoices
@inject IInvoiceService Invoices
@inject NavigationManager Navigation

<PageTitle>@(Invoice?.Number ?? "Invoice") - BillFoundry</PageTitle>

@if (_loading)
{
    <p role="status">Loading invoice.</p>
}
else if (_notFound)
{
    <section class="page-header">
        <h1>Invoice not found</h1>
        <p>The invoice does not exist. <a href="/Invoices">Return to invoices</a>.</p>
    </section>
}
else if (Invoice is not null)
{
    <section class="page-header page-header-split">
        <div>
            <h1>@Invoice.Number</h1>
            <p class="lede">
                <span class="status-badge @InvoiceFormatting.StatusClass(Invoice.EffectiveStatus)">
                    @Invoice.StatusLabel
                </span>
                <span> @Invoice.ClientName</span>
            </p>
        </div>
        <div class="form-actions">
            @if (Invoice.CanEdit)
            {
                <a class="button-primary" href="@($"/Invoices/{Id}/Edit")">Edit</a>
            }
            <button type="button" class="button-secondary" @onclick="DuplicateAsync">Duplicate</button>
            <a class="button-secondary" href="/Invoices">All invoices</a>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="form-status" role="status">@StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="form-alert" role="alert">@ErrorMessage</div>
    }

    @if (Errors.Count > 0)
    {
        <div class="form-errors" role="alert">
            <p>Please correct the following:</p>
            <ul>
                @foreach (string error in Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <section class="panel panel-wide" aria-labelledby="summary-heading">
        <h2 id="summary-heading">Summary</h2>
        <dl class="definition-list">
            <div>
                <dt>Billed to</dt>
                <dd>
                    <a href="@($"/Clients/{Invoice.ClientId}")">@Invoice.ClientName</a>
                    <span> (@Invoice.ClientCode)</span>
                    @if (!string.IsNullOrWhiteSpace(Invoice.ClientEmail))
                    {
                        <span> · @Invoice.ClientEmail</span>
                    }
                    @if (!Invoice.ClientIsActive)
                    {
                        <span> (inactive)</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Issue date</dt>
                <dd>@Invoice.IssueDate.ToString("d")</dd>
            </div>
            <div>
                <dt>Due date</dt>
                <dd>@Invoice.DueDate.ToString("d")</dd>
            </div>
            <div>
                <dt>Purchase order</dt>
                <dd>@(string.IsNullOrWhiteSpace(Invoice.PurchaseOrder) ? "—" : Invoice.PurchaseOrder)</dd>
            </div>
            <div>
                <dt>Currency</dt>
                <dd>@Invoice.CurrencyCode</dd>
            </div>
            @if (Invoice.SourceEstimateId is Guid estimateId)
            {
                <div>
                    <dt>Source estimate</dt>
                    <dd><a href="@($"/Estimates/{estimateId}")">Open estimate</a></dd>
                </div>
            }
            <div>
                <dt>Notes</dt>
                <dd>@(string.IsNullOrWhiteSpace(Invoice.Notes) ? "—" : Invoice.Notes)</dd>
            </div>
            <div>
                <dt>Payment instructions</dt>
                <dd>@(string.IsNullOrWhiteSpace(Invoice.PaymentInstructions) ? "—" : Invoice.PaymentInstructions)</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Invoice.VoidReason))
            {
                <div>
                    <dt>Void reason</dt>
                    <dd>@Invoice.VoidReason</dd>
                </div>
            }
        </dl>
        @if (Invoice.AllowedTransitions.Contains(InvoiceStatus.Sent))
        {
            <div class="form-actions">
                <button type="button" class="button-secondary" @onclick="MarkSentAsync">
                    @InvoiceStatusRules.ActionLabel(InvoiceStatus.Sent)
                </button>
            </div>
        }
        @if (Invoice.CanVoid)
        {
            <EditForm Model="VoidInput" OnValidSubmit="VoidAsync" class="void-form">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="invoice-void-reason">Void reason</label>
                    <InputTextArea id="invoice-void-reason" class="form-input" @bind-Value="VoidInput.Reason" aria-required="true" />
                    <ValidationMessage For="() => VoidInput.Reason" />
                    <p class="form-hint">Voiding keeps the invoice number and history. Invoices are not deleted.</p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="button-secondary">@InvoiceStatusRules.ActionLabel(InvoiceStatus.Void)</button>
                </div>
            </EditForm>
        }
        else if (Invoice.Status is InvoiceStatus.Void)
        {
            <p class="form-hint">Voided invoices are historical and cannot be edited or deleted.</p>
        }
        else if (!Invoice.CanEdit)
        {
            <p class="form-hint">Sent and paid invoices keep their billed amounts. Record received payments below. Payments are not deleted; reverse a payment to correct it.</p>
        }
    </section>

    <section class="panel panel-wide" aria-labelledby="lines-heading">
        <h2 id="lines-heading">Line items</h2>
        <p class="form-hint">Each line stores the description, quantity, unit, price, and taxable flag from when it was saved. Later catalog price or client name changes do not update this invoice.</p>
        @if (Invoice.Lines.Count == 0)
        {
            <p>No line items have been added@(Invoice.CanEdit ? "." : " to this invoice.")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="visually-hidden">Invoice lines</caption>
                    <thead>
                        <tr>
                            <th scope="col">Description</th>
                            <th scope="col" class="numeric">Qty</th>
                            <th scope="col">Unit</th>
                            <th scope="col" class="numeric">Unit price</th>
                            <th scope="col">Tax</th>
                            <th scope="col" class="numeric">Amount</th>
                            @if (Invoice.CanEdit)
                            {
                                <th scope="col">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (InvoiceLineDto line in Invoice.Lines)
                        {
                            <tr>
                                <td>@line.Description</td>
                                <td class="numeric">@InvoiceFormatting.FormatQuantity(line.Quantity)</td>
                                <td>@line.UnitLabel</td>
                                <td class="numeric">@InvoiceFormatting.FormatPrice(line.UnitPrice, Invoice.CurrencyCode)</td>
                                <td>@(line.IsTaxable ? "Taxable" : "No")</td>
                                <td class="numeric">@InvoiceFormatting.FormatAmount(line.LineAmount, Invoice.CurrencyCode)</td>
                                @if (Invoice.CanEdit)
                                {
                                    <td>
                                        <div class="table-actions">
                                            <button type="button" class="button-secondary" @onclick="() => BeginEditLine(line)">Edit</button>
                                            <button type="button"
                                                    class="button-secondary"
                                                    disabled="@(line.SortOrder == 0)"
                                                    @onclick="() => MoveLineAsync(line.Id, -1)">
                                                Move up
                                            </button>
                                            <button type="button"
                                                    class="button-secondary"
                                                    disabled="@(line.SortOrder == Invoice.Lines.Count - 1)"
                                                    @onclick="() => MoveLineAsync(line.Id, 1)">
                                                Move down
                                            </button>
                                            <button type="button" class="button-secondary" @onclick="() => RemoveLineAsync(line.Id)">Remove</button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h3 id="totals-heading">Totals</h3>
        <dl class="definition-list totals-list">
            <div>
                <dt>Subtotal</dt>
                <dd>@InvoiceFormatting.FormatAmount(Invoice.Subtotal, Invoice.CurrencyCode)</dd>
            </div>
            <div>
                <dt>Discount</dt>
                <dd>@InvoiceFormatting.FormatAmount(Invoice.Discount, Invoice.CurrencyCode)</dd>
            </div>
            <div>
                <dt>Taxable amount</dt>
                <dd>@InvoiceFormatting.FormatAmount(Invoice.TaxableSubtotal, Invoice.CurrencyCode)</dd>
            </div>
            <div>
                <dt>Tax (@InvoiceFormatting.FormatRate(Invoice.TaxRatePercent))</dt>
                <dd>@InvoiceFormatting.FormatAmount(Invoice.Tax, Invoice.CurrencyCode)</dd>
            </div>
            <div>
                <dt>Total</dt>
                <dd>@InvoiceFormatting.FormatAmount(Invoice.Total, Invoice.CurrencyCode)</dd>
            </div>
            <div>
                <dt>Amount paid</dt>
                <dd>@InvoiceFormatting.FormatAmount(Invoice.AmountPaid, Invoice.CurrencyCode)</dd>
            </div>
            <div>
                <dt>Balance due</dt>
                <dd>@InvoiceFormatting.FormatAmount(Invoice.BalanceDue, Invoice.CurrencyCode)</dd>
            </div>
        </dl>

        @if (Invoice.CanEdit)
        {
            <h3 id="line-form-heading">@(_editingLineId is null ? "Add line" : "Edit line")</h3>
            <EditForm Model="LineInput" OnValidSubmit="SaveLineAsync" aria-labelledby="line-form-heading">
                <DataAnnotationsValidator />
                <ValidationSummary class="form-errors" />
                @if (CatalogItems.Count > 0 && _editingLineId is null)
                {
                    <div class="form-field">
                        <label for="line-catalog">Catalog item</label>
                        <InputSelect id="line-catalog" class="form-input" @bind-Value="SelectedCatalogItemId" @bind-Value:after="ApplyCatalogSelection">
                            <option value="@Guid.Empty">Ad-hoc line (no catalog item)</option>
                            @foreach (InvoiceCatalogOption item in CatalogItems)
                            {
                                <option value="@item.Id">@item.Name — @InvoiceFormatting.FormatPrice(item.UnitPrice, Invoice.CurrencyCode)</option>
                            }
                        </InputSelect>
                        <p class="form-hint">Choosing a catalog item copies the current description, unit, price, and taxable flag. You can edit the snapshot before adding the line.</p>
                    </div>
                }
                <div class="form-grid">
                    <div class="form-field">
                        <label for="line-description">Description</label>
                        <InputText id="line-description" class="form-input" @bind-Value="LineInput.Description" aria-required="true" />
                        <ValidationMessage For="() => LineInput.Description" />
                    </div>
                    <div class="form-field">
                        <label for="line-quantity">Quantity</label>
                        <InputNumber id="line-quantity" class="form-input" @bind-Value="LineInput.Quantity" step="0.0001" aria-required="true" />
                        <ValidationMessage For="() => LineInput.Quantity" />
                    </div>
                    <div class="form-field">
                        <label for="line-unit">Unit</label>
                        <InputSelect id="line-unit" class="form-input" @bind-Value="LineInput.Unit" aria-required="true">
                            @foreach (CatalogUnitType unit in InvoiceFormatting.UnitTypes)
                            {
                                <option value="@unit">@CatalogUnitTypeDisplay.Label(unit)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => LineInput.Unit" />
                    </div>
                    <div class="form-field">
                        <label for="line-price">Unit price (@Invoice.CurrencyCode)</label>
                        <InputNumber id="line-price" class="form-input" @bind-Value="LineInput.UnitPrice" step="0.0001" aria-required="true" />
                        <ValidationMessage For="() => LineInput.UnitPrice" />
                    </div>
                </div>
                <div class="form-field form-field-checkbox">
                    <InputCheckbox id="line-taxable" @bind-Value="LineInput.IsTaxable" />
                    <label for="line-taxable">Taxable</label>
                </div>
                <p class="form-hint">Line amount: @InvoiceFormatting.FormatAmount(PreviewLineAmount, Invoice.CurrencyCode)</p>
                <div class="form-actions">
                    <button type="submit" class="button-primary">
                        @(_editingLineId is null ? "Add line" : "Save line")
                    </button>
                    @if (_editingLineId is not null)
                    {
                        <button type="button" class="button-secondary" @onclick="CancelLineEdit">Cancel</button>
                    }
                </div>
            </EditForm>
        }
    </section>

    <section class="panel panel-wide" aria-labelledby="payments-heading">
        <h2 id="payments-heading">Payments</h2>
        <p class="form-hint">Payments are externally received amounts. Community Edition does not connect to a payment processor and does not allow overpayments. Reverse a receipt to correct it; the original row stays in the history.</p>
        @if (Invoice.Payments.Count == 0)
        {
            <p>No payments have been recorded@(Invoice.CanRecordPayment ? "." : " on this invoice.")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="visually-hidden">Invoice payments</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Method</th>
                            <th scope="col">Reference</th>
                            <th scope="col">Notes</th>
                            <th scope="col" class="numeric">Amount</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (InvoicePaymentDto payment in Invoice.Payments)
                        {
                            <tr>
                                <td>@payment.PaymentDate.ToString("d")</td>
                                <td>@payment.MethodLabel</td>
                                <td>@(string.IsNullOrWhiteSpace(payment.Reference) ? "—" : payment.Reference)</td>
                                <td>
                                    @if (payment.IsReversal)
                                    {
                                        <text>Reversal@(string.IsNullOrWhiteSpace(payment.ReversalReason) ? "" : $": {payment.ReversalReason}")</text>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(payment.Notes) ? "—" : payment.Notes)
                                    }
                                </td>
                                <td class="numeric">
                                    @if (payment.IsReversal)
                                    {
                                        <text>−@InvoiceFormatting.FormatAmount(payment.Amount, Invoice.CurrencyCode)</text>
                                    }
                                    else
                                    {
                                        @InvoiceFormatting.FormatAmount(payment.Amount, Invoice.CurrencyCode)
                                    }
                                </td>
                                <td>
                                    @if (payment.CanReverse)
                                    {
                                        <button type="button" class="button-secondary" @onclick="() => BeginReverse(payment.Id)">Reverse</button>
                                    }
                                    else if (payment.IsReversal)
                                    {
                                        <span>Correction</span>
                                    }
                                    else
                                    {
                                        <span>Reversed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_reversingPaymentId is not null)
        {
            <h3 id="reverse-form-heading">Reverse payment</h3>
            <EditForm Model="ReverseInput" OnValidSubmit="ReversePaymentAsync" aria-labelledby="reverse-form-heading">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="payment-reverse-reason">Reversal reason</label>
                    <InputTextArea id="payment-reverse-reason" class="form-input" @bind-Value="ReverseInput.Reason" aria-required="true" />
                    <ValidationMessage For="() => ReverseInput.Reason" />
                    <p class="form-hint">The original payment remains in the history. A linked reversal reduces amount paid.</p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="button-primary">Save reversal</button>
                    <button type="button" class="button-secondary" @onclick="CancelReverse">Cancel</button>
                </div>
            </EditForm>
        }
        else if (Invoice.CanRecordPayment)
        {
            <h3 id="payment-form-heading">Record payment</h3>
            <EditForm Model="PaymentInput" OnValidSubmit="RecordPaymentAsync" aria-labelledby="payment-form-heading">
                <DataAnnotationsValidator />
                <ValidationSummary class="form-errors" />
                <div class="form-grid">
                    <div class="form-field">
                        <label for="payment-date">Payment date</label>
                        <InputDate id="payment-date" class="form-input" @bind-Value="PaymentInput.PaymentDate" aria-required="true" />
                        <ValidationMessage For="() => PaymentInput.PaymentDate" />
                    </div>
                    <div class="form-field">
                        <label for="payment-amount">Amount (@Invoice.CurrencyCode)</label>
                        <InputNumber id="payment-amount" class="form-input" @bind-Value="PaymentInput.Amount" step="0.01" aria-required="true" />
                        <ValidationMessage For="() => PaymentInput.Amount" />
                        <p class="form-hint">Balance due is @InvoiceFormatting.FormatAmount(Invoice.BalanceDue, Invoice.CurrencyCode). Overpayments are not allowed.</p>
                    </div>
                    <div class="form-field">
                        <label for="payment-method">Method</label>
                        <InputSelect id="payment-method" class="form-input" @bind-Value="PaymentInput.Method" aria-required="true">
                            @foreach (PaymentMethod method in InvoiceFormatting.PaymentMethods)
                            {
                                <option value="@method">@PaymentMethodDisplay.Label(method)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => PaymentInput.Method" />
                    </div>
                    <div class="form-field">
                        <label for="payment-reference">Reference</label>
                        <InputText id="payment-reference" class="form-input" @bind-Value="PaymentInput.Reference" />
                        <ValidationMessage For="() => PaymentInput.Reference" />
                    </div>
                </div>
                <div class="form-field">
                    <label for="payment-notes">Notes</label>
                    <InputTextArea id="payment-notes" class="form-input" @bind-Value="PaymentInput.Notes" />
                    <ValidationMessage For="() => PaymentInput.Notes" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="button-primary">Record payment</button>
                </div>
            </EditForm>
        }
    </section>
}
