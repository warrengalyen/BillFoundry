@page "/Dashboard"
@attribute [Authorize(Policy = AuthorizationPolicies.ManageInvoices)]
@using BillFoundry.Application.Invoices
@using BillFoundry.Application.Reporting
@using BillFoundry.Web.Invoices
@inject IReportingService Reporting
@inject IInvoiceService InvoiceService

<PageTitle>Dashboard - BillFoundry</PageTitle>

<section class="page-header page-header-split">
    <div>
        <h1>Dashboard</h1>
        <p class="lede">Receivables and collections as of @_asOfLabel.</p>
    </div>
    <div class="form-actions">
        <a class="button-primary" href="/Invoices/New">Create invoice</a>
        <a class="button-secondary" href="/Estimates/New">Create estimate</a>
    </div>
</section>

@if (_error is not null)
{
    <div class="form-alert" role="alert">@_error</div>
}
else if (_metrics is null)
{
    <p role="status">Loading dashboard.</p>
}
else
{
    <section class="dashboard-kpi" aria-label="Financial summary">
        <div class="kpi-item">
            <span class="kpi-label">Outstanding</span>
            <span class="kpi-value">@InvoiceFormatting.FormatAmount(_metrics.OutstandingReceivables, _metrics.CurrencyCode)</span>
            <span class="kpi-detail">@_metrics.OpenInvoiceCount open</span>
        </div>
        <div class="kpi-item kpi-overdue">
            <span class="kpi-label">Overdue</span>
            <span class="kpi-value">@InvoiceFormatting.FormatAmount(_metrics.OverdueReceivables, _metrics.CurrencyCode)</span>
            <span class="kpi-detail">@_metrics.OverdueInvoiceCount overdue</span>
        </div>
        <div class="kpi-item">
            <span class="kpi-label">Paid this month</span>
            <span class="kpi-value">@InvoiceFormatting.FormatAmount(_metrics.PaymentsThisMonth, _metrics.CurrencyCode)</span>
            <span class="kpi-detail">@_metrics.AsOf.ToString("MMMM yyyy")</span>
        </div>
        <div class="kpi-item">
            <span class="kpi-label">Paid this year</span>
            <span class="kpi-value">@InvoiceFormatting.FormatAmount(_metrics.PaymentsThisYear, _metrics.CurrencyCode)</span>
            <span class="kpi-detail">@_metrics.AsOf.Year</span>
        </div>
    </section>

    <div class="dashboard-panels">
        <section class="panel" aria-labelledby="aging-heading">
            <div class="results-header">
                <h2 id="aging-heading">Invoice aging</h2>
                <a href="/Reports/Aging">Full report</a>
            </div>
            <ReportBarChart Items="_agingChart" />
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="visually-hidden">Invoice aging by bucket</caption>
                    <thead>
                        <tr>
                            <th scope="col">Bucket</th>
                            <th class="numeric" scope="col">Invoices</th>
                            <th class="numeric" scope="col">Balance due</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AgingBucketRow bucket in _metrics.Aging)
                        {
                            <tr>
                                <td>@bucket.Label</td>
                                <td class="numeric">@bucket.InvoiceCount</td>
                                <td class="numeric">@InvoiceFormatting.FormatAmount(bucket.BalanceDue, _metrics.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel" aria-labelledby="payments-heading">
            <div class="results-header">
                <h2 id="payments-heading">Payments (@_metrics.AsOf.Year)</h2>
                <a href="/Reports/Payments">Payment reports</a>
            </div>
            <ReportBarChart Items="_monthChart" />
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="visually-hidden">Net payments received by month this year</caption>
                    <thead>
                        <tr>
                            <th scope="col">Month</th>
                            <th class="numeric" scope="col">Receipts</th>
                            <th class="numeric" scope="col">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MonthlyPaymentRow row in _metrics.PaymentsByMonth)
                        {
                            <tr>
                                <td>@row.PeriodLabel</td>
                                <td class="numeric">@row.PaymentCount</td>
                                <td class="numeric">@InvoiceFormatting.FormatAmount(row.Amount, _metrics.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <section class="panel panel-wide" aria-labelledby="recent-invoices-heading">
        <div class="results-header">
            <h2 id="recent-invoices-heading">Recent open invoices</h2>
            <a href="/Invoices">View all invoices</a>
        </div>
        @if (_recentInvoices is { Count: > 0 })
        {
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="visually-hidden">Recent open invoices requiring attention</caption>
                    <thead>
                        <tr>
                            <th scope="col">Invoice</th>
                            <th scope="col">Client</th>
                            <th scope="col">Due</th>
                            <th scope="col">Status</th>
                            <th class="numeric" scope="col">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (InvoiceListItemDto invoice in _recentInvoices)
                        {
                            <tr>
                                <td><a href="/Invoices/@invoice.Id">@invoice.Number</a></td>
                                <td>@invoice.ClientName</td>
                                <td>@invoice.DueDate.ToString("MMM d, yyyy")</td>
                                <td><span class="status-badge @InvoiceFormatting.StatusClass(invoice.EffectiveStatus)">@invoice.StatusLabel</span></td>
                                <td class="numeric">@InvoiceFormatting.FormatAmount(invoice.BalanceDue, invoice.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="results-count">No open invoices.</p>
        }
    </section>
}

@code {
    private DashboardMetrics? _metrics;
    private IReadOnlyList<InvoiceListItemDto>? _recentInvoices;
    private string? _error;
    private string _asOfLabel = string.Empty;
    private IReadOnlyList<ReportBarItem> _agingChart = [];
    private IReadOnlyList<ReportBarItem> _monthChart = [];

    protected override async Task OnInitializedAsync()
    {
        ReportingResult<DashboardMetrics> result = await Reporting.GetDashboardAsync();
        if (result.IsForbidden)
        {
            _error = "You are not allowed to view receivables.";
            return;
        }

        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Errors.Count > 0 ? string.Join(" ", result.Errors) : "The dashboard could not be loaded.";
            return;
        }

        _metrics = result.Value;
        _asOfLabel = _metrics.AsOf.ToString("MMMM d, yyyy");
        decimal agingMax = Math.Max(1m, _metrics.Aging.Max(bucket => bucket.BalanceDue));
        _agingChart = _metrics.Aging.Select(bucket => new ReportBarItem(
            bucket.Label,
            bucket.BalanceDue,
            InvoiceFormatting.FormatAmount(bucket.BalanceDue, _metrics.CurrencyCode),
            agingMax)).ToList();
        decimal monthMax = Math.Max(1m, _metrics.PaymentsByMonth.Max(row => row.Amount));
        _monthChart = _metrics.PaymentsByMonth.Select(row => new ReportBarItem(
            row.PeriodLabel,
            row.Amount,
            InvoiceFormatting.FormatAmount(row.Amount, _metrics.CurrencyCode),
            monthMax)).ToList();

        InvoiceListQuery recentQuery = new()
        {
            PageSize = 10,
            SortBy = InvoiceSortField.DueDate,
            SortDescending = false,
            OverdueOnly = false,
            Status = InvoiceStatusFilter.All
        };
        recentQuery.Normalize();

        InvoiceListResult invoiceResult = await InvoiceService.ListAsync(recentQuery);
        if (invoiceResult.Succeeded && invoiceResult.Page is not null)
        {
            _recentInvoices = invoiceResult.Page.Items
                .Where(i => i.EffectiveStatus is Domain.Invoices.InvoiceStatus.Sent
                    or Domain.Invoices.InvoiceStatus.PartiallyPaid
                    or Domain.Invoices.InvoiceStatus.Overdue)
                .Take(10)
                .ToList();
        }
    }
}
