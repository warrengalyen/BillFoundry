@page "/Invoices/{Id:guid}/Edit"
@attribute [Authorize(Policy = AuthorizationPolicies.ManageInvoices)]
@rendermode InteractiveServer
@using BillFoundry.Application.Invoices
@using BillFoundry.Web.Invoices
@inject IInvoiceService Invoices
@inject NavigationManager Navigation

<PageTitle>Edit invoice - BillFoundry</PageTitle>

<section class="page-header">
    <h1>Edit invoice</h1>
    <p class="lede">@(InvoiceNumber ?? "Update the draft invoice header. Line items are managed on the invoice page.")</p>
</section>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="form-status" role="status">@StatusMessage</div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="form-alert" role="alert">@ErrorMessage</div>
}

@if (Errors.Count > 0)
{
    <div class="form-errors" role="alert">
        <p>Please correct the following:</p>
        <ul>
            @foreach (string error in Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (_loading)
{
    <p role="status">Loading invoice.</p>
}
else if (_notFound)
{
    <section class="panel">
        <h2>Invoice not found</h2>
        <p>The invoice does not exist. <a href="/Invoices">Return to invoices</a>.</p>
    </section>
}
else if (!_canEdit)
{
    <section class="panel">
        <h2>This invoice cannot be edited</h2>
        <p>Only draft invoices can be changed. <a href="@($"/Invoices/{Id}")">Return to the invoice</a>.</p>
    </section>
}
else
{
    <section class="panel panel-wide" aria-labelledby="invoice-form-heading">
        <h2 id="invoice-form-heading" class="visually-hidden">Invoice form</h2>
        <EditForm Model="Input" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-errors" />
            <InvoiceEditorFields Input="Input" Clients="Clients" CurrencyCode="CurrencyCode" />
            <div class="form-actions">
                <button type="submit" class="button-primary">Save invoice</button>
                <a class="button-secondary" href="@($"/Invoices/{Id}")">Cancel</a>
            </div>
        </EditForm>
    </section>
}
