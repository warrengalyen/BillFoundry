<div class="table-actions table-actions--icons">
    <span class="icon-button-host" data-tooltip="Edit line">
        <button type="button"
                class="icon-button"
                aria-label="Edit line"
                @onclick="OnEdit">
            <svg class="icon-button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                <path d="m15 5 4 4" />
            </svg>
        </button>
    </span>
    <span class="icon-button-host" data-tooltip="Move up">
        <button type="button"
                class="icon-button"
                aria-label="Move up"
                disabled="@(!CanMoveUp)"
                @onclick="OnMoveUp">
            <svg class="icon-button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12 7-7 7 7" />
                <path d="M12 19V5" />
            </svg>
        </button>
    </span>
    <span class="icon-button-host" data-tooltip="Move down">
        <button type="button"
                class="icon-button"
                aria-label="Move down"
                disabled="@(!CanMoveDown)"
                @onclick="OnMoveDown">
            <svg class="icon-button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14" />
                <path d="m19 12-7 7-7-7" />
            </svg>
        </button>
    </span>
    <span class="icon-button-host" data-tooltip="Remove line">
        <button type="button"
                class="icon-button icon-button--danger"
                aria-label="Remove line"
                @onclick="OnRemove">
            <svg class="icon-button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18" />
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                <line x1="10" x2="10" y1="11" y2="17" />
                <line x1="14" x2="14" y1="11" y2="17" />
            </svg>
        </button>
    </span>
</div>

@code {
    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }
}
